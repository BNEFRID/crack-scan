body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f4f7fb;
  color: #1f2937;
}

.hero {
  background: linear-gradient(135deg, #0f172a, #2563eb);
  color: white;
  padding: 70px 40px;
  text-align: center;
}

.hero h1 {
  font-size: 48px;
  margin-bottom: 10px;
}

.hero button,
.card button {
  background: #22c55e;
  color: white;
  border: none;
  padding: 12px 25px;
  border-radius: 8px;
  font-weight: bold;
  cursor: pointer;
}

.dashboard {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 25px;
  padding: 40px;
}

.card {
  background: white;
  padding: 25px;
  border-radius: 16px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

.card h2 {
  color: #2563eb;
}

input {
  width: 100%;
  padding: 10px;
  margin: 8px 0 15px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
}

.badge {
  display: inline-block;
  background: #fee2e2;
  color: #b91c1c;
  padding: 8px 14px;
  border-radius: 20px;
  font-weight: bold;
}

.visual {
  padding: 40px;
}

.images {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 18px;
}

.images div {
  height: 200px;
  background: white;
  border: 2px dashed #94a3b8;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}
